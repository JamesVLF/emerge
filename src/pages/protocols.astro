---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const protocols = (await getCollection('protocols', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Protocols | James" description="Lab protocols and procedures">
  <div class="max-w-4xl mx-auto">
    <div class="mb-16">
      <h1 class="text-5xl md:text-6xl font-display font-semibold mb-6 bg-gradient-to-r from-neural-900 to-dendrite-dark bg-clip-text text-transparent">
        Protocols
      </h1>
      <p class="text-xl text-neural-600 font-body leading-relaxed">
        Lab protocols, procedures, and methodological notes. Versioned, dated, and revised
        as practice evolves.
      </p>
    </div>

    {protocols.length === 0 ? (
      <p class="text-neural-600 font-body">No protocols published yet.</p>
    ) : (
      <div class="space-y-12">
        {protocols.map((protocol) => (
          <article class="group">
            <a href={`/protocols/${protocol.slug}`} class="block">
              <div class="bg-white/60 backdrop-blur-sm rounded-lg p-8 border border-neural-200 hover:border-dendrite-light transition-all duration-300 hover:shadow-lg">
                <div class="flex items-center gap-4 mb-2 flex-wrap">
                  <time class="text-sm font-mono text-neural-500">
                    {protocol.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  {protocol.data.version && (
                    <span class="text-xs font-mono px-3 py-1 bg-dendrite-light/20 text-dendrite-dark rounded-full">
                      {protocol.data.version}
                    </span>
                  )}
                  {protocol.data.updated && protocol.data.updated.valueOf() !== protocol.data.pubDate.valueOf() && (
                    <span class="text-xs font-mono text-neural-500">
                      Updated {protocol.data.updated.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </span>
                  )}
                </div>

                <h2 class="text-2xl md:text-3xl font-display font-semibold mb-3 text-neural-800 group-hover:text-dendrite-dark transition-colors">
                  {protocol.data.title}
                </h2>

                {protocol.data.description && (
                  <p class="text-neural-600 font-body mb-4 leading-relaxed">
                    {protocol.data.description}
                  </p>
                )}

                {protocol.data.tags && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {protocol.data.tags.map((tag) => (
                      <span class="text-xs font-mono px-3 py-1 bg-neural-100 text-neural-600 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <div class="mt-4 text-dendrite-dark font-mono text-sm opacity-0 group-hover:opacity-100 transition-opacity">
                  Read protocol →
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
