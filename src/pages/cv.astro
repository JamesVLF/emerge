---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV | James" description="Curriculum vitae of James LaFemina">
  <div class="max-w-5xl mx-auto">
    <div class="mb-12">
      <h1 class="text-5xl md:text-6xl font-display font-semibold mb-6 bg-gradient-to-r from-neural-900 to-synapse-dark bg-clip-text text-transparent">
        Curriculum Vitae
      </h1>
      <p class="text-xl text-neural-600 font-body leading-relaxed">
        <a href="/cv.pdf" download class="text-synapse-dark hover:text-synapse underline">
          Download as PDF →
        </a>
      </p>
    </div>

    <iframe
      src="/cv.pdf#view=FitH"
      style="width: 100%; height: 90vh; border: 1px solid #e5e7eb; border-radius: 0.5rem;"
      title="James LaFemina CV"
    ></iframe>
  </div>
</BaseLayout>
